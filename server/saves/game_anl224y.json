:"suburb_2","districtId":"suburb","idx":2,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0},{"id":"suburb_3","districtId":"suburb","idx":3,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0},{"id":"suburb_4","districtId":"suburb","idx":4,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0}],"players":[{"id":"you","name":"你","title":"新晋炒家","color":"#3aa7ff","kind":"human","income":30,"cash":500,"isBankrupt":false,"bankruptAt":null,"memory":[],"relations":{},"stats":{"bought":0,"sold":0,"peakAssets":500}},{"id":"zheng","name":"郑伯昌","title":"老钱·收租公","color":"#c9a227","kind":"ai","bio":"城中村起家，年轻时拆出第一桶金，如今握着一整条老街。信奉“现金流才是真的”，口头禅是“我这铺子十年前就这个价”。讨厌杠杆，更讨厌欠银行钱的人。面相敦厚，心里一本账。","strategy":"只买核心区与学区收租，从不加杠杆；囤现金，等死对手。别人缺钱时，他会“帮把手”——五折。","income":28,"cash":500,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"对方自称现金紧，求接盘滨江新区；我按五折逻辑口头试探365万，未给正式offer，等他亮具体地块和底价。"}],"relations":{"you":0},"stats":{"bought":0,"sold":0,"peakAssets":500}},{"id":"kai","name":"洪凯文","title":"杠杆炒客","color":"#e05252","kind":"ai","bio":"私募出身，朋友圈签名“杠杆是人类的第八大奇迹”。上轮牛市全仓滨江新区翻了五倍，也爆过两次仓，至今觉得第三次会不同。话多，手更痒。","strategy":"满杠杆追概念区（滨江/高新/城中村拆迁），擅长拉抬后塞给接盘侠。相場瘋狂我更瘋。","income":6,"cash":500,"isBankrupt":false,"bankruptAt":null,"memory":[],"relations":{},"stats":{"bought":0,"sold":0,"peakAssets":500}},{"id":"lin","name":"林曼卿","title":"价值派·做局者","color":"#7b6cf6","kind":"ai","bio":"某价值投资基金合伙人，永远在算别人的底牌。说话客气到让你心慌，下手从不客气。坊间传闻她有一本记账所有人黑历史的本子。","strategy":"低谷吸货、泡沫出货；最擅长联合老二搞老大——谁领先她就去拉拢谁，针对谁。","income":16,"cash":500,"isBankrupt":false,"bankruptAt":null,"memory":[],"relations":{},"stats":{"bought":0,"sold":0,"peakAssets":500}}],"offers":[],"negotiationLog":{"zheng":[{"role":"player","text":"郑老板，我手上现金紧，滨江那块地您有兴趣吗？价钱好商量。"},{"role":"npc","text":"现金紧？早说了，借银行的钱都是毒药，早晚被利息吸干。滨江那破地方十年前还是鱼塘，现在报七百多万，回报率三点零，租都租不出几个钱，也就你们这些炒家敢接。你要真想出手，三百五十万，我帮你扛一扛——别绕圈子，我这人爽快。"}]},"pendingNews":[{"headline":"央行降息10BP，释放稳楼市信号","body":"五年期LPR下调10基点，购房月供减少，分析师称市场预期有望企稳回暖。","category":"policy","effects":{"laocheng":0.02,"riverside":0.02,"chengzhong":0.02},"rateChange":-10},{"headline":"地铁九号线东延段正式开工","body":"滨江新区直达老城核心，通勤缩至二十分钟，沿线楼盘到访量明显增加。","category":"infra","effects":{"riverside":0.05,"laocheng":0.02},"rateChange":0},{"headline":"三大科技龙头签约落户高新区","body":"头部企业落地预计带动两万就业岗位，人才购房与租赁需求预期走强。","category":"firm","effects":{"highnew":0.04},"rateChange":0}],"newsHistory":[[{"headline":"央行降息10BP，释放稳楼市信号","body":"五年期LPR下调10基点，购房月供减少，分析师称市场预期有望企稳回暖。","category":"policy","effects":{"laocheng":0.02,"riverside":0.02,"chengzhong":0.02},"rateChange":-10},{"headline":"地铁九号线东延段正式开工","body":"滨江新区直达老城核心，通勤缩至二十分钟，沿线楼盘到访量明显增加。","category":"infra","effects":{"riverside":0.05,"laocheng":0.02},"rateChange":0},{"headline":"三大科技龙头签约落户高新区","body":"头部企业落地预计带动两万就业岗位，人才购房与租赁需求预期走强。","category":"firm","effects":{"highnew":0.04},"rateChange":0}]],"log":[{"q":0,"text":"📰 央行降息10BP，释放稳楼市信号——五年期LPR下调10基点，购房月供减少，分析师称市场预期有望企稳回暖。","tone":"info","t":1790862115332},{"q":0,"text":"📰 地铁九号线东延段正式开工——滨江新区直达老城核心，通勤缩至二十分钟，沿线楼盘到访量明显增加。","tone":"info","t":1790862115334},{"q":0,"text":"📰 三大科技龙头签约落户高新区——头部企业落地预计带动两万就业岗位，人才购房与租赁需求预期走强。","tone":"info","t":1790862115335},{"q":0,"text":"宏观：复苏周期，基准利率 3.00%（降息 10bp）","tone":"info","t":1790862115336},{"q":0,"text":"郑伯昌对你说：现金紧？早说了，借银行的钱都是毒药，早晚被利息吸干。滨江那破地方十年前还是鱼塘，现在报七百多万，回报率三点零，租都租不出几个钱，也就你们这些炒家敢接。你要真想出手，三百五十万，我帮你扛一扛——别绕圈子，我这人爽快。","tone":"speech","t":1790862122243}],"playerAp":3,"negotiatedThisTurn":{"zheng":true},"over":false,"ranking":null,"epilogues":{},"createdAt":1790862105328,"seed":315241366}