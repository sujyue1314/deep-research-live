ons":{"kai":-1},"stats":{"bought":2,"sold":0,"peakAssets":510}}],"offers":[],"negotiationLog":{},"pendingNews":[{"headline":"公积金贷款额度上限上调至120万","body":"市住房公积金管理中心宣布上调多子女家庭贷款额度，刚需购房门槛进一步降低，市场情绪偏暖。","category":"policy","effects":{"laocheng":0.03,"chengzhong":0.05,"campus":0.04,"suburb":0.02},"rateChange":0},{"headline":"二季度服务业PMI重回扩张区间","body":"商务活动指数回升至52.4，商办租赁问询量增加，金融城部分业主撤牌观望，报价企稳。","category":"macro","effects":{"finance":0.04,"highnew":0.02,"laocheng":0.02},"rateChange":0},{"headline":"电商巨头区域总部落户金融中心","body":"头部电商平台拿下金融中心两栋写字楼，整层租赁成交带动周边商铺租金预期。","category":"firm","effects":{"finance":0.05,"laocheng":0.02},"rateChange":0}],"newsHistory":[[{"headline":"央行下调LPR 25个基点","body":"为支持实体经济复苏，央行下调贷款市场报价利率，楼市预期回暖，看房量显著上升。","category":"policy","effects":{"laocheng":0.03,"finance":0.02,"riverside":0.04,"highnew":0.04,"campus":0.03,"chengzhong":0.03,"industrial":0.02,"suburb":0.02},"rateChange":-25},{"headline":"滨江新区地铁4号线正式开工","body":"轨道交通规划落地，滨江新区通勤配套升级，沿线楼盘关注度骤升。","category":"infra","effects":{"riverside":0.08},"rateChange":0},{"headline":"高新区龙头企业宣布扩招","body":"芯片龙头企业扩建研发中心并大规模招聘，人才房需求预期上升。","category":"firm","effects":{"highnew":0.06,"campus":0.03},"rateChange":0}],[{"headline":"公积金贷款额度上限上调至120万","body":"市住房公积金管理中心宣布上调多子女家庭贷款额度，刚需购房门槛进一步降低，市场情绪偏暖。","category":"policy","effects":{"laocheng":0.03,"chengzhong":0.05,"campus":0.04,"suburb":0.02},"rateChange":0},{"headline":"二季度服务业PMI重回扩张区间","body":"商务活动指数回升至52.4，商办租赁问询量增加，金融城部分业主撤牌观望，报价企稳。","category":"macro","effects":{"finance":0.04,"highnew":0.02,"laocheng":0.02},"rateChange":0},{"headline":"电商巨头区域总部落户金融中心","body":"头部电商平台拿下金融中心两栋写字楼，整层租赁成交带动周边商铺租金预期。","category":"firm","effects":{"finance":0.05,"laocheng":0.02},"rateChange":0}]],"log":[{"q":0,"text":"📰 央行下调LPR 25个基点——为支持实体经济复苏，央行下调贷款市场报价利率，楼市预期回暖，看房量显著上升。","tone":"info","t":1790863364907},{"q":0,"text":"📰 滨江新区地铁4号线正式开工——轨道交通规划落地，滨江新区通勤配套升级，沿线楼盘关注度骤升。","tone":"info","t":1790863364908},{"q":0,"text":"📰 高新区龙头企业宣布扩招——芯片龙头企业扩建研发中心并大规模招聘，人才房需求预期上升。","tone":"info","t":1790863364910},{