b","idx":1,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0},{"id":"suburb_2","districtId":"suburb","idx":2,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0},{"id":"suburb_3","districtId":"suburb","idx":3,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0},{"id":"suburb_4","districtId":"suburb","idx":4,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0}],"players":[{"id":"you","name":"你","title":"新晋炒家","color":"#3aa7ff","kind":"human","income":30,"cash":416.7848,"isBankrupt":false,"bankruptAt":null,"memory":[],"relations":{},"stats":{"bought":1,"sold":0,"peakAssets":555}},{"id":"zheng","name":"郑伯昌","title":"老钱·收租公","color":"#c9a227","kind":"ai","bio":"城中村起家，年轻时拆出第一桶金，如今握着一整条老街。信奉“现金流才是真的”，口头禅是“我这铺子十年前就这个价”。讨厌杠杆，更讨厌欠银行钱的人。面相敦厚，心里一本账。","strategy":"只买核心区与学区收租，从不加杠杆；囤现金，等死对手。别人缺钱时，他会“帮把手”——五折。","income":28,"cash":312.62080000000003,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"策略：只入手老城/大学城学区收租地，绝不上杠杆；滨江概念留给洪凯文们去追，等他们资金链断了再五折收货。"}],"relations":{"kai":-1},"stats":{"bought":2,"sold":0,"peakAssets":556}},{"id":"kai","name":"洪凯文","title":"杠杆炒客","color":"#e05252","kind":"ai","bio":"私募出身，朋友圈签名“杠杆是人类的第八大奇迹”。上轮牛市全仓滨江新区翻了五倍，也爆过两次仓，至今觉得第三次会不同。话多，手更痒。","strategy":"满杠杆追概念区（滨江/高新/城中村拆迁），擅长拉抬后塞给接盘侠。相場瘋狂我更瘋。","income":6,"cash":3.383649999999985,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"Q1已满仓买入滨江两块空地（各约225万，现金余约50万）。主策略：借T3地铁概念持有，2027年前后通车预期兑现前清仓甩给接盘侠；下季视行情抵押加仓。新玩家'你'买老城laocheng_0（131万），风格保守，暂不构成威胁。"},{"q":1,"text":"Q2抵押riverside_0贷151万@4.5%，满仓买入高新空地（约195万），现金仅剩6万，季现金流约-2.4万。下季计划抵押高新地（可贷约116万）补流动性；紧盯芯华招聘进度与T3环线消息；林曼卿持riverside_2与chengzhong_0，她在赌城中村拆迁，是我滨江同船人也是对手。"}],"relations":{"you":1},"stats":{"bought":3,"sold":0,"peakAssets":549}},{"id":"lin","name":"林曼卿","title":"价值派·做局者","color":"#7b6cf6","kind":"ai","bio":"某价值投资基金合伙人，永远在算别人的底牌。说话客气到让你心慌，下手从不客气。坊间传闻她有一本记账所有人黑历史的本子。","strategy":"低谷吸货、泡沫出货；最擅长联合老二搞老大——谁领先她就去拉拢谁，针对谁。","income":16,"cash":265.5704,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text"