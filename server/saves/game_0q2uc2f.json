0,"loan":0,"loanRate":0},{"id":"suburb_2","districtId":"suburb","idx":2,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0},{"id":"suburb_3","districtId":"suburb","idx":3,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0},{"id":"suburb_4","districtId":"suburb","idx":4,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0}],"players":[{"id":"you","name":"你","title":"新晋炒家","color":"#3aa7ff","kind":"human","income":30,"cash":387.8912,"isBankrupt":false,"bankruptAt":null,"memory":[],"relations":{},"stats":{"bought":1,"sold":0,"peakAssets":524}},{"id":"zheng","name":"郑伯昌","title":"老钱·收租公","color":"#c9a227","kind":"ai","bio":"城中村起家，年轻时拆出第一桶金，如今握着一整条老街。信奉“现金流才是真的”，口头禅是“我这铺子十年前就这个价”。讨厌杠杆，更讨厌欠银行钱的人。面相敦厚，心里一本账。","strategy":"只买核心区与学区收租，从不加杠杆；囤现金，等死对手。别人缺钱时，他会“帮把手”——五折。","income":28,"cash":180.8952,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"Q1降息25bp市场普涨。买入城中村+大学城各一块，成本约131万，余现金约369万。计划：后续开发收租，囤现金等杠杆客资金链断裂后五折收货。"},{"q":1,"text":"Q2投入210万将城中村(chengzhong_0)与大学城(campus_0)空地开发为住宅，预计季租金收入约+24万（7万+17万）。现金余约181万。继续盯洪凯文（现金仅54万）与林曼卿的资金链，等五折收货机会。"}],"relations":{},"stats":{"bought":2,"sold":0,"peakAssets":522}},{"id":"kai","name":"洪凯文","title":"杠杆炒客","color":"#e05252","kind":"ai","bio":"私募出身，朋友圈签名“杠杆是人类的第八大奇迹”。上轮牛市全仓滨江新区翻了五倍，也爆过两次仓，至今觉得第三次会不同。话多，手更痒。","strategy":"满杠杆追概念区（滨江/高新/城中村拆迁），擅长拉抬后塞给接盘侠。相場瘋狂我更瘋。","income":6,"cash":53.6432,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"Q1已入手滨江新区2块空地（各222.9万，现金余约54万）。计划：下季抵押滨江地块套现445.8万×2额度，继续加仓滨江/高新，吃隧道与降息概念，待疯狂期抛售。郑伯昌是死多头收租派，可利用其接盘。"}],"relations":{"zheng":0},"stats":{"bought":2,"sold":0,"peakAssets":500}},{"id":"lin","name":"林曼卿","title":"价值派·做局者","color":"#7b6cf6","kind":"ai","bio":"某价值投资基金合伙人，永远在算别人的底牌。说话客气到让你心慌，下手从不客气。坊间传闻她有一本记账所有人黑历史的本子。","strategy":"低谷吸货、泡沫出货；最擅长联合老二搞老大——谁领先她就去拉拢谁，针对谁。","income":16,"cash":378.8952,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"Q1：吸货城中村(28.8万,6.8%回报)+大学城(102.3万,4.5%)。洪凯文持riverside_0/1，成本各223万，现金仅54万、无杠杆——盯死其流动性，急钱时抄底。郑伯昌持城中村+大学城各一套，与吾同向，可拉拢制衡凯文。"}],"relations":{"kai":1,"zheng":2},"stats":{"bought":2,"sold":0,"peakAssets":510}}],"offers":[],"negotiationLog":{},"pendingNews":[{"headline":"江城出台住房\"以旧换新\"试点","body":"老城区居民卖旧买新可享契税补贴，首批试点撬动改善需求，核心区二手房带看量激增。","category":"policy","effects":{"laocheng":0.05,"riverside":0.04,"chengzhong":0.03},"rateChange":0},{"headline":"地铁8号线二期规划获批","body":"8号线二期串联大学城与高新区核心，预计三年内通车，沿线新盘备案价立涨，人才通勤半径扩大。","category":"infra","effects":{"highnew":0.06,"campus":0.05,"industrial":0.03},"rateChange":0},{"headline":"高新区龙头企业宣布扩建研发中心","body":"区内龙头科技公司落子扩建研发中心，新增三千高层次岗位，人才购房补贴讨论升温。","category":"firm","effects":{"highnew":0.05,"campus":0.03,"riverside":0.02},"rateChange":0}],"newsHistory":[[{"headline":"央行年内首降LPR 25基点","body":"央行下调5年期LPR 25bp，江城多家银行同步下调房贷利率，需求端回暖预期升温。","category":"policy","effects":{"laocheng":0.06,"finance":0.05,"riverside":0.07,"highnew":0.05,"campus":0.04,"chengzhong":0.03,"industrial":0.02,"suburb":0.02},"rateChange":-25},{"headline":"滨江新区跨江隧道正式开工","body":"江城第二条过江隧道开工，串联老城区与滨江新区核心，通勤时间将缩短至10分钟。","category":"infra","effects":{"riverside":0.08,"laocheng":0.03},"rateChange":0},{"headline":"江城制造业PMI重返扩张区间","body":"一季度制造业PMI回升至52.1，高新区与工业园区企业扩产，产业人口流入加快。","category":"macro","effects":{"highnew":0.06,"industrial":0.06},"rateChange":0}],[{"headline":"江城出台住房\"以旧换新\"试点","body":"老城区居民卖旧买新可享契税补贴，首批试点撬动改善需求，核心区二手房带看量激增。","category":"policy","effects":{"laocheng":0.05,"riverside":0.04,"chengzhong":0.03},"rateChange":0},{"headline":"地铁8号线二期规划获批","body":"8号线二期串联大学城与高新区核心，预计三年内通车，沿线新盘备案价立涨，人才通勤半径扩大。","category":"infra","effects":{"highnew":0.06,"campus":0.05,"industrial":0.03},"rateChange":0},{"headline":"高新区龙头企业宣布扩建研发中心","body":"区内龙头科技公司落子扩建研发中心，新增三千高层次岗位，人才购房补贴讨论升温。","category":"firm","effects":{"highnew":0.05,"campus":0.03,"riverside":0.02},"rateChange":0}]],"log":[{"q":0,"text":"📰 央行年内首降LPR 25基点——央行下调5年期LPR 25bp，江城多家银行同步下调房贷利率，需求端回暖预期升温。","tone":"info","t":1790863056081},{"q":0,"text":"📰 滨江新区跨江隧道正式开工——江城第二条过江隧道开工，串联老城区与滨江新区核心，通勤时间将缩短至10分钟。","tone":"info","t":1790863056082}