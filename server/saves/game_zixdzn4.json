:0},{"id":"suburb_2","districtId":"suburb","idx":2,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0},{"id":"suburb_3","districtId":"suburb","idx":3,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0},{"id":"suburb_4","districtId":"suburb","idx":4,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0}],"players":[{"id":"you","name":"你","title":"新晋炒家","color":"#3aa7ff","kind":"ai","income":30,"cash":99.6608,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"Q1梭哈滨江两套空地（各212.4万，共424.8万），赌地铁9号线二期利好+6%；计划波段持有，涨势走平就跑，别被郑伯昌的收租思维带偏。"}],"relations":{},"stats":{"bought":2,"sold":0,"peakAssets":524},"bio":"白手起家的散户炒家，靠一次滨江拆迁吃满了第一桶金。信奉\"别人贪婪我更贪婪\"，上头的时候会把现金扑个精光。","strategy":"跟风强庄，追涨杀跌；现金少的时候敢梭哈，有钱了反而犹豫。"},{"id":"zheng","name":"郑伯昌","title":"老钱·收租公","color":"#c9a227","kind":"ai","bio":"城中村起家，年轻时拆出第一桶金，如今握着一整条老街。信奉“现金流才是真的”，口头禅是“我这铺子十年前就这个价”。讨厌杠杆，更讨厌欠银行钱的人。面相敦厚，心里一本账。","strategy":"只买核心区与学区收租，从不加杠杆；囤现金，等死对手。别人缺钱时，他会“帮把手”——五折。","income":28,"cash":390.8952,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"Q1开局：全现金500万，零物业。策略——只买老城区（学区/核心）收租，买地+升级住宅；囤现金等杠杆客（尤其洪凯文）资金链断裂后五折抄底。滨江708万是概念泡沫，坚决不碰。"}],"relations":{"kai":-1},"stats":{"bought":1,"sold":0,"peakAssets":522}},{"id":"kai","name":"洪凯文","title":"杠杆炒客","color":"#e05252","kind":"ai","bio":"私募出身，朋友圈签名“杠杆是人类的第八大奇迹”。上轮牛市全仓滨江新区翻了五倍，也爆过两次仓，至今觉得第三次会不同。话多，手更痒。","strategy":"满杠杆追概念区（滨江/高新/城中村拆迁），擅长拉抬后塞给接盘侠。相場瘋狂我更瘋。","income":6,"cash":75.6608,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"Q1已以212.4万/块买入两块滨江空地（共424.8万），剩余现金约75.2万。计划：等滨江利好发酵涨价后抵押加仓，择机拉抬出货给接盘侠。重点关注：林曼卿是否在算计我的仓位，郑伯昌是否动手抢城中村。"}],"relations":{"you":0,"zheng":0,"lin":1},"stats":{"bought":2,"sold":0,"peakAssets":500}},{"id":"lin","name":"林曼卿","title":"价值派·做局者","color":"#7b6cf6","kind":"ai","bio":"某价值投资基金合伙人，永远在算别人的底牌。说话客气到让你心慌，下手从不客气。坊间传闻她有一本记账所有人黑历史的本子。","strategy":"低谷吸货、泡沫出货；最擅长联合老二搞老大——谁领先她就去拉拢谁，针对谁。","income":16,"cash":97.6704,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"Q1以412.2万买入金融中心+大学城各1宗（余现金约88万）。判断滨江7.3%已部分兑现利好、暂不追高；核心策略是复苏周期持有低估值核心资产。持续观察郑伯昌（疑似偏好城中村）与洪凯文（杠杆激进）的建仓方向，谁领先就拉拢另一方。"}],"relations":{},"stats":{"bought":2,"sold":0,"peakAssets":510}}],"offers":[],"negotiationLog":{},"pendingNews":[{"headline":"滨江新区地铁9号线二期获批立项","body":"市发改委批复轨道交通三期规划，滨江新区将是最大受益板块。","category":"infra","effects":{"riverside":0.06,"laocheng":0.02},"rateChange":0},{"headline":"江城出台人才购房补贴实施细则","body":"对高新区、大学城引进人才给予最高30万元购房补贴，最多补贴5年。","category":"policy","effects":{"highnew":0.05,"campus":0.05},"rateChange":0},{"headline":"一季度经济开局良好 GDP增速5.2%","body":"工业增加值与社零双双回升，企业信贷需求显著改善，经济回升势头确立。","category":"macro","effects":{"finance":0.03,"laocheng":0.02},"rateChange":0}],"newsHistory":[[{"headline":"滨江新区地铁9号线二期获批立项","body":"市发改委批复轨道交通三期规划，滨江新区将是最大受益板块。","category":"infra","effects":{"riverside":0.06,"laocheng":0.02},"rateChange":0},{"headline":"江城出台人才购房补贴实施细则","body":"对高新区、大学城引进人才给予最高30万元购房补贴，最多补贴5年。","category":"policy","effects":{"highnew":0.05,"campus":0.05},"rateChange":0},{"headline":"一季度经济开局良好 GDP增速5.2%","body":"工业增加值与社零双双回升，企业信贷需求显著改善，经济回升势头确立。","category":"macro","effects":{"finance":0.03,"laocheng":0.02},"rateChange":0}]],"log":[{"q":0,"text":"📰 滨江新区地铁9号线二期获批立项——市发改委批复轨道交通三期规划，滨江新区将是最大受益板块。","tone":"info","t":1790863774725},{"q":0,"text":"📰 江城出台人才购房补贴实施细则——对高新区、大学城引进人才给予最高30万元购房补贴，最多补贴5年。","tone":"info","t":1790863774726},{"q":0,"text":"📰 一季度经济开局良好 GDP增速5.2%——工业增加值与社零双双回升，企业信贷需求显著改善，经济回升势头确立。","tone":"info","t":1790863774727},{"q":0,"text":"宏观：复苏周期，基准利率 3.10%","tone":"info","t":1790863774728},{"q":0,"text":"你买入滨江新区空地（riverside_0），花 212万","tone":"action","t":1790863854071},{"q":0,"text":"你买入滨江新区空地（riverside_1），花 212万","tone":"action","t":1790863854072},{"q":0,"text":"你：9号线一通，滨江就是下一个宇宙中心，各位别怪我没喊你们上车。","tone":"speech","t":1790863854073},{"q":0,"text":"郑伯昌买入老城区空地（laocheng_0），花 131万","tone":"action","t":1790863861256},{"q":0,"text":"郑伯昌 试图操作但失败：地块不属于你或不存在","tone":"warn","t":1790863861257},{"q":0,"text":"郑伯昌：我这人笨，看不懂什么杠杆奇迹。铺子租出去，月月有钱进账，那才叫真的。","tone":"speech","t":1790863861257},{"q":0,"text":"洪凯文买入滨江新区空地（riverside_2），花 212万","tone":"action","t":1790863862718},{"q":0,"text":"洪凯文买入滨江新区空地（riverside_3），花 212万","tone":"action","t":1790863862719},{"q":0,"text":"洪凯文：9号线二期？我凯文上次在滨江翻五倍，开头也是这味儿。货我先屯上，你们慢慢猜。","tone":"speech","t":1790863862720},{"q":0,"text":"林曼卿买入金融中心空地（finance_0），花 305万","tone":"action","t":1790863873885},{"q":0,"text":"林曼卿买入大学城空地（campus_0），花 107万","tone":"action","t":1790863873885},{"q":0,"text":"林曼卿：市场是真热闹，可惜我胆子小、本钱薄，只敢先捡两块自认为便宜的上上手，赚个安稳钱——各位大佬多多发财，以后带带我呀。","tone":"speech","t":1790863873886}],"playerAp":3,"negotiatedThisTurn":{},"over":false,"ranking":null,"epilogues":{},"createdAt":1790863769857,"seed":474707020}