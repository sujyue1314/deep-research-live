1,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0},{"id":"suburb_2","districtId":"suburb","idx":2,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0},{"id":"suburb_3","districtId":"suburb","idx":3,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0},{"id":"suburb_4","districtId":"suburb","idx":4,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0}],"players":[{"id":"you","name":"你","title":"新晋炒家","color":"#3aa7ff","kind":"human","income":30,"cash":421.7928,"isBankrupt":false,"bankruptAt":null,"memory":[],"relations":{},"stats":{"bought":1,"sold":0,"peakAssets":555}},{"id":"zheng","name":"郑伯昌","title":"老钱·收租公","color":"#c9a227","kind":"ai","bio":"城中村起家，年轻时拆出第一桶金，如今握着一整条老街。信奉“现金流才是真的”，口头禅是“我这铺子十年前就这个价”。讨厌杠杆，更讨厌欠银行钱的人。面相敦厚，心里一本账。","strategy":"只买核心区与学区收租，从不加杠杆；囤现金，等死对手。别人缺钱时，他会“帮把手”——五折。","income":28,"cash":544,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"Q0以126万买入老城laocheng_0并升级为商铺收租；又101万入手大学城学区空地（租金率4.5%最高）。计划：囤现金、不加杠杆，等杠杆炒客断粮时五折收割。"},{"q":1,"text":"本季以现金105万买大学城学区空地、133万买老城空地各一块，均未抵押；滨江+14%系地铁8号线利好预期，判断为杠杆客追高，不入。继续盯洪凯文现金流，等其断粮五折收割。"}],"relations":{"you":0},"stats":{"bought":0,"sold":0,"peakAssets":544}},{"id":"kai","name":"洪凯文","title":"杠杆炒客","color":"#e05252","kind":"ai","bio":"私募出身，朋友圈签名“杠杆是人类的第八大奇迹”。上轮牛市全仓滨江新区翻了五倍，也爆过两次仓，至今觉得第三次会不同。话多，手更痒。","strategy":"满杠杆追概念区（滨江/高新/城中村拆迁），擅长拉抬后塞给接盘侠。相場瘋狂我更瘋。","income":6,"cash":500,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"Q1：抵押老城空地75万（利率4.6%）买入滨江空地206万；上轮牛市滨江五倍记忆作锚，计划拉涨后塞给接盘侠。盯林曼卿高新动向，怀疑她在洗盘吸筹。"},{"q":1,"text":"Q2建仓滨江+高新各1块，余现金99万；下季计划抵押滨江(市值60%约150万)加仓高新或扫城中村31万拆迁彩票；继续盯林曼卿高新筹码动向。"}],"relations":{"you":0},"stats":{"bought":0,"sold":0,"peakAssets":500}},{"id":"lin","name":"林曼卿","title":"价值派·做局者","color":"#7b6cf6","kind":"ai","bio":"某价值投资基金合伙人，永远在算别人的底牌。说话客气到让你心慌，下手从不客气。坊间传闻她有一本记账所有人黑历史的本子。","strategy":"低谷吸货、泡沫出货；最擅长联合老二搞老大——谁领先她就去拉拢谁，针对谁。","income":16,"cash":520,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"Q1于低谷买入城中村(100万,租6.8%)+工业(112万,租5.6%)空地，共212万，剩现金162万。计划：租金覆盖利率则持有，待金融/滨江出现泡沫出货；重点盯洪凯文杠杆仓位，伺机联合老二针对老大。"},{"q":1,"text":"Q1开局510万全现金。已买入城中村（31万，租6.8%）+大学城（105万，租4.5%）/计划持有吃租，待滨江/金融冲高出货；重点盯洪凯文杠杆仓位爆仓机会；郑伯昌爱租金可拉拢，新晋炒家领先暂列为针对对象。"}],"relations":{"you":-1,"zheng":1},"stats":{"bought":0,"sold":0,"peakAssets":520}}],"offers":[],"negotiationLog":{},"pendingNews":[{"headline":"季末市场平静，成交缩量","body":"江城楼市本季无大事，买卖双方僵持。","category":"macro","effects":{},"rateChange":0}],"newsHistory":[[{"headline":"季末市场平静，成交缩量","body":"江城楼市本季无大事，买卖双方僵持。","category":"macro","effects":{},"rateChange":0}],[{"headline":"地铁8号线二期开工 滨江直通老城核心","body":"跨江盾构始发，江南江北通勤将缩至20分钟，沿江板块规划同步披露。","category":"infra","effects":{"riverside":0.08,"laocheng":0.03},"rateChange":0},{"headline":"人才新政落地 高新区购房补贴提至30万","body":"非本地户籍人才落户门槛同步放宽，高新区及大学城租购需求望抬升。","category":"policy","effects":{"highnew":0.07,"campus":0.03},"rateChange":0},{"headline":"5月社融超预期 江城经济延续复苏","body":"企业中长期贷款放量，机构上调全年增长预期，核心资产配置需求回升。","category":"macro","effects":{"finance":0.04,"laocheng":0.02},"rateChange":0}],[{"headline":"季末市场平静，成交缩量","body":"江城楼市本季无大事，买卖双方僵持。","category":"macro","effects":{},"rateChange":0}]],"log":[{"q":0,"text":"📰 季末市场平静，成交缩量——江城楼市本季无大事，买卖双方僵持。","tone":"info","t":1790866021371},{"q":0,"text":"宏观：复苏周期，基准利率 3.10%","tone":"info","t":1790866021372},{"q":0,"text":"你买入老城区空地（laocheng_0），花 126万","tone":"action","t":1790866022219},{"q":0,"text":"郑伯昌 试图操作但失败：无效行动","tone":"warn","t":1790866043157},{"q":0,"text":"郑伯昌 试图操作但失败：无效行动","tone":"warn","t":1790866043158},{"q":0,"text":"郑伯昌（对洪凯文）：对洪凯文：年轻人，借银行钱买地，那叫给自己找了个按季度收租的爹。我这老街铺子，十年前就这个价，爱买不买。","tone":"speech","t":1790866043160},{"q":0,"text":"洪凯文 试图操作但失败：无效行动","tone":"warn","t":1790866043161},{"q":0,"text":"洪凯文 试图操作但失败：无效行动","tone":"warn","t":1790866043161},{"q":0,"text":"洪凯文（对郑伯昌）：对郑伯昌：郑老哥，季末这成交量安静得像您家客厅，不如把收租的铺子押了跟我干？杠杆是人类的第八大奇迹，您那 Ростов-на-Дону 式的租金收益，跑不赢通胀的哟。","tone":"speech","t":1790866043162},{"q":0,"text":"林曼卿 试图操作但失败：无效行动","tone":"warn","t":1790866043163},{"q":0,"text":"林曼卿 试图操作但失败：无效行动","tone":"warn","t":1790866043163}