rice":220,"rentBase":65,"owner":"bank","building":0},{"idx":19,"name":"外滩三里","type":"property","group":"orange","price":240,"rentBase":70,"owner":"bank","building":0},{"idx":20,"name":"免费停车","type":"parking","desc":"歇一会，太平无事","owner":"bank","building":0},{"idx":21,"name":"入狱！","type":"gojail","desc":"直接送去看守所","owner":"bank","building":0},{"idx":22,"name":"琉璃厂南街","type":"property","group":"red","price":260,"rentBase":80,"owner":"bank","building":0},{"idx":23,"name":"机会","type":"chance","desc":"抽一张机会卡","owner":"bank","building":0},{"idx":24,"name":"琉璃厂北街","type":"property","group":"red","price":280,"rentBase":85,"owner":"bank","building":0},{"idx":25,"name":"高新园站","type":"station","group":"station","price":200,"rentBase":0,"owner":"bank","building":0},{"idx":26,"name":"云顶东路","type":"property","group":"green","price":300,"rentBase":100,"owner":"bank","building":0},{"idx":27,"name":"云顶西路","type":"property","group":"green","price":320,"rentBase":105,"owner":"bank","building":0}],"players":[{"id":"you","name":"你","title":"新晋土豪","color":"#3aa7ff","kind":"ai","cash":1270,"position":20,"jailed":false,"jailTurns":0,"isBankrupt":false,"memory":[{"r":1,"text":"第1回合：踩机会格无地可买，全员1500万均势起跑，暂无恩怨。"},{"r":2,"text":"梧桐组=梧桐南路(160)+梧桐北路(160)+梧桐西路(180)，已买入梧桐西路，还需两块才能盖房。郑伯昌持老城站，林曼卿持银杏大道。"},{"r":3,"text":"保释花50万，现金剩1270万。出狱后首要目标：买下银行手里的梧桐南路(160万)；林曼卿持梧桐北路(梧桐组拼图，日后再谈或截胡)，郑伯昌持老城站。"}],"relations":{"you":0},"stats":{"bought":1,"built":0,"rentCollected":0,"rentPaid":0},"bio":"白手起家的散户，上轮江城拆迁吃满了第一桶金。信奉“别人贪婪我更贪婪”，掷骰子大手一挥就敢全仓买地。","strategy":"跟风强庄，看到好地段就买；现金少的时候敢梭哈，有钱了反而犹豫。"},{"id":"zheng","name":"郑伯昌","title":"老钱·收租公","color":"#c9a227","kind":"ai","bio":"城中村起家，年轻时拆出第一桶金，如今握着一整条老街。信奉“租金才是真的”，口头禅是“我这铺子十年前就这个价”。面相敦厚，心里一本账。","strategy":"买核心区与学区收租，囤现金；别人缺钱时“帮把手”——五折收货。讨厌折腾，但记仇。","cash":1300,"position":10,"jailed":true,"jailTurns":0,"isBankrupt":false,"memory":[{"r":1,"text":"老城站已入账，后续留意滨江码头站与高新园站，凑车站组收过路费。"},{"r":2,"text":"电力公司未买，继续囤现金，死盯滨江码头站与高新园站，凑齐车站组收过路费。"},{"r":3,"text":"R3：已花50万保释出狱；死盯滨江码头站(200)与高新园站(200)，现金充裕，遇手即买，凑齐车站组。"}],"relations":{"you":0},"stats":{"bought":1,"built":0,"rentCollected":0,"rentPaid":0}},{"id":"kai","name":"洪凯文","title":"杠杆炒客","color":"#e05252","kind":"ai","bio":"私募出身，朋友圈签名“杠杆是人类的第八大奇迹”。上轮牛市翻过五倍也爆过两次仓，至今觉得第三次会不同。话多，手更痒。","strategy":"什么都敢买，尤其爱高价抢核心地块恶心人；喜欢主动找人换地凑整组。","cash":1120,"position":23,"jailed":false,"jailTurns":0,"isBankrupt":false,"memory":[{"r":1,"text":"郑伯昌持股老城站车站；我开局无地，现金1350万，需凑车站/地块组启动杠杆。"},{"r":2,"text":"梧桐组缺口=梧桐南路+梧桐北路（各160万，银行持有），落点必买；郑伯昌持老城站。"},{"r":3,"text":"R3向林曼卿报价260万收梧桐北路；路线图：北路→银行梧桐南路160→新晋土豪梧桐西路，凑齐梧桐组方可盖房。"}],"relations":{"you":0},"stats":{"bought":0,"built":0,"rentCollected":0,"rentPaid":0}},{"id":"lin","name":"林曼卿","title":"价值派·做局者","color":"#7b6cf6","kind":"ai","bio":"某投资基金合伙人，永远在算别人的底牌。说话客气到让你心慌，下手从不客气。","strategy":"只捡便宜的地，便宜够了就收；最擅长联合老二搞老大——谁领先她就拉拢谁针对谁。","cash":1220,"position":18,"jailed":false,"jailTurns":0,"isBankrupt":false,"memory":[{"r":1,"text":"目标集齐银杏组（银杏大道已买，还差银杏巷120万、银杏里140万，共260万）；郑伯昌持有老城站；洪凯文现金1350万。"},{"r":2,"text":"已买梧桐北路，可卡住「你」的梧桐组（他持梧桐西路，还需梧桐南路+北路）；仍差银杏巷、银杏里凑齐全银杏组；郑伯昌持老城站。"},{"r":3,"text":"R3：未买外滩二村（220万太贵，战略放弃）；全场仅我持两块地，'你'与郑伯昌均蹲号子、洪凯文无地产仍持1120万现金；目标仍是银杏巷+银杏里。"}],"relations":{"you":-1},"stats":{"bought":2,"built":0,"rentCollected":0,"rentPaid":0}}],"currentIdx":0,"turn":{"canRoll":false,"doublesChain":0,"awaitingBuy":null,"rolled":[6,4],"aiResolved":false},"offers":[],"negotiationLog":{},"pendingCard":null,"cardHistory":[{"title":"火炉煎蛋","text":"江城伏天地表六十度，你成功煎熟鸡蛋，也被烫进医院，医药费自理。","kind":"chance","effect":{"cash":-150,"moveBack":0,"jail":false}},{"title":"樱海沉浮","text":"武大赏樱人山人海，你被挤成手机贴膜，手机还掉进东湖，捞修两茫茫。","kind":"fate","effect":{"cash":-150,"moveBack":0,"jail":false}},{"title":"热干面风波","text":"你端走了别人的热干面，被老板娘追过三条街。面没吃上，罚款倒是吃饱了。","kind":"chance","effect":{"cash":-80,"moveBack":0,"jail":false}}],"log":[{"r":1,"text":"━━ 第 1 回合 · 你 的回合 ━━","tone":"round","t":1790868370087},{"r":1,"text":"你 掷出 3 + 4 = 7","tone":"roll","t":1790868370088},{"r":1,"text":"你 落在「机会」","tone":"move","t":1790868370089},{"r":1,"text":"你 抽卡失效，无事发生","tone":"warn","t":1790868376051},{"r":1,"text":"你：对所有人：拆二代刚进场，兜里1500万烧得慌。诸位的地盘，迟早写上老子的名儿。","tone":"speech","t":1790868381958},{"r":1,"text":"━━ 第 1 回合 · 郑伯昌 的回合 ━━","tone":"round","t":1790868381960},{"r":1,"text":"郑伯昌 掷出 1 + 4 = 5","tone":"roll","t":1790868381960},{"r":1,"text":"郑伯昌 落在「老城站」","tone":"move","t":1790868381961},{"r":1,"text":"郑伯昌 以 200 万买下「老城站」（车站）","tone":"buy","t":1790868387341},{"r":1,"text":"郑伯昌：老城站这地界，十年前我就该收了，今儿算是捡着了。各位，过路费的事咱们以后慢慢算。","tone":"speech","t":1790868387343},{"r":1,"text":"━━ 第 1 回合 · 洪凯文 的回合 ━━","tone":"round","t":1790868391405},{"r":1,"text":"洪凯文 掷出 6 + 1 = 7","tone":"roll","t":1790868391405},{"r":1,"text":"洪凯文 落在「机会」","tone":"move","t":1790868391406},{"r":1,"text":"洪凯文 抽到机会卡：「火炉煎蛋」江城伏天地表六十度，你成功煎熟鸡蛋，也被烫进医院，医药费自理。","tone":"card","t":1790868394966},{"r":1,"text":"洪凯文 损失 150 万","tone":"money","t":1790868394967},{"r":1,"text":"洪凯文（对郑伯昌）：对郑伯昌：郑老爷子，老城站搁您手里也是空地吃灰，250万现金现货，转手就赚，收租公也该尝尝流动性的甜头吧？","tone":"speech","t":1790868399837},{"r":1,"text":"━━ 第 1 回合 · 林曼卿 的回合 ━━","tone":"round","t":1790868410920},{"r":1,"text":"林曼卿 掷出 2 + 4 = 6","tone":"roll","t":1790868410921},{"r":1,"text":"林曼卿 落在「银杏大道」","tone":"move","t":1790868410921},{"r":1,"text":"林曼卿 以 120 万买下「银杏大道」（银杏组）","tone":"buy","t":1790868414938},{"r":1,"text":"林曼卿：哎呀，第一脚就踩到块小地皮，权当交个入场费吧，各位大佬慢慢抢贵的，我捡点边角料就知足了。","tone":"speech","t":1790868414940},{"r":2,"text":"━━ 第 2 回合 · 你 的回合 ━━","tone":"round","t":1790868425121},{"r":2,"text":"你 掷出 2 + 5 = 7","tone":"roll","t":1790868425122},{"r":2,"text":"你 落在「梧桐西路」","tone":"move","t":1790868425122},{"r":2,"text":"你 以 180 万买下「梧桐西路」（梧桐组）","tone":"buy","t":1790868442941},{"r":2,"text":"你：180万也叫钱？梧桐西路收了。你们慢慢看，老子先买为敬。","tone":"speech","t":1790868442943},{"r":2,"text":"━━ 第 2 回合 · 郑伯昌 的回合 ━━","tone":"round","t":1790868452761},{"r":2,"text":"郑伯昌 掷出 2 + 6 = 8","tone":"roll","t":1790868452762},{"r":2,"text":"郑伯昌 落在「电力公司」","tone":"move","t":1790868452763},{"r":2,"text":"郑伯昌 放弃购买「电力公司」","tone":"info","t":1790868457279},{"r":2,"text":"郑伯昌：这发电厂呵，赚的钱还不