stBasis":0,"loan":0,"loanRate":0},{"id":"suburb_2","districtId":"suburb","idx":2,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0},{"id":"suburb_3","districtId":"suburb","idx":3,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0},{"id":"suburb_4","districtId":"suburb","idx":4,"owner":"bank","level":0,"costBasis":0,"loan":0,"loanRate":0}],"players":[{"id":"you","name":"你","title":"新晋炒家","color":"#3aa7ff","kind":"human","income":30,"cash":50.6216,"isBankrupt":false,"bankruptAt":null,"memory":[],"relations":{},"stats":{"bought":3,"sold":0,"peakAssets":524}},{"id":"zheng","name":"郑伯昌","title":"老钱·收租公","color":"#c9a227","kind":"ai","bio":"城中村起家，年轻时拆出第一桶金，如今握着一整条老街。信奉“现金流才是真的”，口头禅是“我这铺子十年前就这个价”。讨厌杠杆，更讨厌欠银行钱的人。面相敦厚，心里一本账。","strategy":"只买核心区与学区收租，从不加杠杆；囤现金，等死对手。别人缺钱时，他会“帮把手”——五折。","income":28,"cash":292.8168,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"初次见面。对方持有滨江新区两块空地，现金约62万，疑有杠杆。保持警惕，观望其来意。"},{"q":0,"text":"对手（you）全仓滨江两块空地+工业地，现金仅27万，空地零租金，现金流脆弱；我Q1买入老城区+大学城学区地各一块（126.9万+101.7万），留现金约271万，计划下季升级收租；待对手断链后以五折收割其资产。"}],"relations":{"you":-1},"stats":{"bought":2,"sold":0,"peakAssets":522}},{"id":"kai","name":"洪凯文","title":"杠杆炒客","color":"#e05252","kind":"ai","bio":"私募出身，朋友圈签名“杠杆是人类的第八大奇迹”。上轮牛市全仓滨江新区翻了五倍，也爆过两次仓，至今觉得第三次会不同。话多，手更痒。","strategy":"满杠杆追概念区（滨江/高新/城中村拆迁），擅长拉抬后塞给接盘侠。相場瘋狂我更瘋。","income":6,"cash":61.6496,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"新晋炒家持有 riverside_0、riverside_1 两块滨江空地，现金约62万。先探探其出手意愿。"},{"q":0,"text":"Q1以219.3万/套扫入2套滨江空地（银行挂牌仅剩1套）。隧道利好仍在发酵，Q2计划抵押两块滨江地（上限约60%≈263万）继续扩仓高新或扫滨江。新晋炒家仍持riverside_0/1、现金约62万，是未来拉抬后的第一接盘对象。"}],"relations":{"you":2},"stats":{"bought":2,"sold":0,"peakAssets":500}},{"id":"lin","name":"林曼卿","title":"价值派·做局者","color":"#7b6cf6","kind":"ai","bio":"某价值投资基金合伙人，永远在算别人的底牌。说话客气到让你心慌，下手从不客气。坊间传闻她有一本记账所有人黑历史的本子。","strategy":"低谷吸货、泡沫出货；最擅长联合老二搞老大——谁领先她就去拉拢谁，针对谁。","income":16,"cash":445.9488,"isBankrupt":false,"bankruptAt":null,"memory":[{"q":0,"text":"洪凯文重仓riverside_2/3(约438万)赌隧道概念、现金仅62万，为当前最激进多头；郑伯昌持laocheng_0+campus_0，偏好学区且爱五折捡漏；新玩家持3块空地(含2块滨江)现金仅27万，是未来带血筹码的来源。我Q1低调吸城中村+工业园空地，保持400万+弹药，计划两三季后接盘。"}],"relations":{},"stats":{"bought":2,"sold":0,"peakAssets":510}}],"offers":[],"negotiationLog":{"zheng":[{"role":"player","text":"你好"},{"role":"npc","text":"坐吧，喝茶。我这铺子十年前就这个价，租金月月到账，踏实。倒是你，滨江两块空地捏手里，账上就六十来万现金——欠银行不少吧？别哪天资金链断了，跑来求我帮把手，我可只出五折。"}],"kai":[{"role":"player","text":"你好"},{"role":"npc","text":"哟，新来的吧？听说你手里捏着两块滨江的空地？巧了，滨江可是我的主场——上轮牛市我全仓滨江翻了五倍。怎么着，捏得住还是想换点现金？开个价，我这人痛快，就是手痒。"}]},"pendingNews":[{"headline":"过热板块收紧 滨江备案价限涨","body":"针对滨江、金融城涨幅过快，住建局收紧备案价指导并严查捂盘惜售，投资客预期降温。","category":"policy","effects":{"riverside":-0.07,"finance":-0.04},"rateChange":0},{"headline":"江城一季度GDP增速6.2%超预期","body":"出口与制造业双轮驱动、社零回升，居民购房信心修复，产业聚集区受益明显。","category":"macro","effects":{"highnew":0.04,"industrial":0.04,"suburb":0.02},"rateChange":0},{"headline":"城中村改造专项借款首批落地","body":"国开行专项借款50亿到位，三大片区启动签约搬家，业主心理报价集体上调。","category":"firm","effects":{"chengzhong":0.08,"laocheng":0.02},"rateChange":0}],"newsHistory":[[{"headline":"过江隧道二期动工 滨江直连金融城","body":"通车后两地通勤缩至15分钟，滨江新区带看量周环比接近翻倍。","category":"infra","effects":{"finance":0.03,"riverside":0.08},"rateChange":0},{"headline":"江城发布人才购房新政 高新区最高补20万","body":"政策定向补贴硕博人才购房，高新区与大学城刚需咨询量激增。","category":"policy","effects":{"highnew":0.08,"campus":0.04},"rateChange":0},{"headline":"江城制造业PMI重回扩张线 工业租金止跌","body":"企业扩产带动厂房租赁回暖，工业园区租金环比止跌、空置率回落。","category":"macro","effects":{"industrial":0.05},"rateChange":0}],[{"headline":"过热板块收紧 滨江备案价限涨","body":"针对滨江、金融城涨幅过快，住建局收紧备案价指导并严查捂盘惜售，投资客预期降温。","category":"policy","effects":{"riverside":-0.07,"finance":-0.04},"rateChange":0},{"headline":"江城一季度GDP增速6.2%超预期","body":"出口与制造业双轮驱动、社零回升，居民购房信心修复，产业聚集区受益明显。","category":"macro","effects":{"highnew":0.04,"industrial":0.04,"suburb":0.02},"rateChange":0},{"headline":"城中村改造专项借款首批落地","body":"国开行专项借款50亿到位，三大片区启动签约搬家，业主心理报价集体上调。","category":"firm","effects":{"chengzhong":0.08,"laocheng":0.02},"rateChange":0}]],"log":[{"q":0,"text":"📰 过江隧道二期动工 滨江直连金融城——通车后两地通勤缩至15分钟，滨江新区带看量周环比接近翻倍。","tone":"info","t":1790863615411},{"q":0,"text":"📰 江城发布人才购房新政 高新区最高补20万——政策定向补贴硕博人才购房，高新区与大学城刚需咨询量激增。","tone":"info","t":1790863615412},{"q":0,"text":"📰 江城制造业PMI重回扩张线 工业租金止跌——企业扩产带动厂房租赁回暖，工业园区租金环比止跌、空置率回落。","tone":"info","t":1790863615412},{"q":0,"text":"宏观：复苏周期，基准利率 3.10%","tone":"info","t":1790863615413},{"q":0,"text":"你买入滨江新区空地（riverside_0），花 219万","tone":"action","t":1790863632541},{"q":0,"text":"你买入滨江新区空地（riverside_1），花 219万","tone":"action","t":1790863633351},{"q":0,"text":"郑伯昌对你说：坐吧，喝茶。我这铺子十年前就这个价，租金月月到账，踏实。倒是你，滨江两块空地捏手里，账上就六十来万现金——欠银行不少吧？别哪天资金链断了，跑来求我帮把手，我可只出五折。","tone":"speech","t":1790863648313},{"q":0,"text":"洪凯文对你说：哟，新来的吧？听说你手里捏着两块滨江的空地？巧了，滨江可是我的主场——上轮牛市我全仓滨江翻了五倍。怎么着，捏得住还是想换点现金？开个价，我这人痛快，就是手痒。","tone":"speech","t":1790863673604},{"q":0,"text":"你买入工业园区空地（industrial_0），花 35万","tone":"action","t":1790863687841},{"q":0,"text":"郑伯昌买入老城区空地（laocheng_0），花 127万","tone":"action","t":1790863750141},{"q":0,"text":"郑伯昌买入大学城空地（campus_0），花 102万","tone":"action","t":1790863750142},{"q":0,"text":"郑伯昌（对你）：滨江那地不生租子，你账上就剩二十来万，能撑几季？我这铺子十年前就这个价。扛不住就来找我，五折，我说话算数。","tone":"speech","t":1790863750143},{"q":0,"text":"洪凯文买入滨江新区空地（riverside_2），花 219万","tone":"action","t":1790863842003},{"q":0,"text":"洪凯文买入滨江新区空地（riverside_3），花 219万","tone":"action","t":1790863842004},{"q":0,"text":"洪凯文：隧道一通，滨江15分钟直达金融城。郑老板那老街铺子以后当仓库收吧，上车的抓紧，下季这价我不保证。","tone":"speech","t":1790863842004},{"q":0,"text":"林曼卿买入城中村空地（chengzhong_0），花 29万","tone":"action","t":1790864019840},{"q":0,"text":"林曼卿买入工业园区空地（industrial_1），花 35万","tone":"action","t":1790864019841},{"q":0,"text":"林曼卿：洪总滨江的局气势如虹，我就不扫兴了，买两间破屋收租度日。各位哪天手头紧了先来找我——我收东西，向来公道。","tone":"speech","t":1790864019841},{"q":1,"text":"📰 过热板块收紧 滨江备案价限涨——针对滨江、金融城涨幅过快，住建局收紧备案价指导并严查捂盘惜售，投资客预期降温。","tone":"info","t":1790864038529},{"q":1,"text":"📰 江城一季度GDP增速6.2%超预期——出口与制造业双轮驱动、社零回升，居民购房信心修复，产业聚集区受益明显。","tone":"info","t":1790864038530},{"q":1,"text":"📰 城中村改造专项借款首批落地——国开行专项借款50亿到位，三大片区启动签约搬家，业主心理报价集体上调。","tone":"info","t":1790864038530},{"q":1,"text":"宏观：扩张